#!/bin/sh
# Copyright 2026 Michael Xymitoulias
# SPDX-License-Identifier: Apache-2.0

JOURNQL_VERSION=0.1.0
DUCKDB_VERSION=1.4.5

usage_error() {
    printf 'journql: %s\n' "$1" >&2
    printf '%s\n' "journql: use 'journql --help' for help." >&2
    exit 2
}

print_version() {
    printf 'journql %s\n' "${JOURNQL_VERSION}"
    printf 'DuckDB %s\n' "${DUCKDB_VERSION}"
}

print_help() {
    cat <<'EOF'
Usage: journql [OPTIONS] -- [JOURNAL SELECTION] -- 'JOURNAL QUERY'

The command needs two -- separators. The first separator ends journql options.
The second separator ends the Journal Selection. The Journal Query is exactly
one shell argument after the second separator.

Options:
  --help                  Show this help and exit. Use this option alone.
  --version               Show journql and DuckDB versions and exit. Use this
                          option alone.
  --format FORMAT         Select the Query Result format.
                          FORMAT is table (default), csv, or json. The
                          --format=FORMAT form is also supported. Use this
                          option at most once.

Journal Selection controls:
  --system, --user, --merge
                          Select system, user, or merged Journal Entries.
  --since, --until, --cursor, --after-cursor, --boot
                          Select a time, cursor position, or boot position.
  --unit, --user-unit, --identifier, --priority, --facility
                          Select by unit, user unit, identifier, priority, or
                          facility.
  --grep, --ignore-case, --dmesg
                          Select by text pattern, case handling, or kernel
                          source.
  --case-sensitive[=BOOLEAN]
                          Control case handling for --grep patterns. The
                          --ignore-case and -i compatibility forms are
                          translated to --case-sensitive=no.
  --lines and --reverse  Limit the Journal Selection and reverse its order.
  FIELD=VALUE and +      Use native field matches and the journal disjunction
                          operator. Path matches are not supported.

Documented short forms and separate-value forms for these journalctl
selection controls are allowed. journql keeps control of the output format,
complete field values, and pager behavior.
Short forms include -m, -b, -u, -t, -p, -g, -i, -k, -n, and -r.
Time and cursor short forms are -S, -U, and -c.
Options that need a value accept a separate argument. The documented
--option=value form is also supported where applicable. Optional values can
be omitted for --boot, --lines, and --case-sensitive.

The default Journal Selection is the normal journalctl selection. journql does
not add a time or size limit. It runs with the current user's authority. Add
the user to the systemd-journal group when the installed package requires it.

journql stores the Journal Selection in a private temporary file under the
configured temporary directory, or the standard temporary directory when it
is not configured. It writes newline-delimited JSON and removes the file after
use. A large Journal Selection can use temporary disk space equal to its JSON
size. Select fewer Journal Entries when necessary.

Missing, repeated, binary, or invalid stable source values become NULL. The
complete original Journal Entry remains available in the entry JSON column.
Version 0.1.0 does not set a maximum number of Journal Entries, Journal
Selection size, or Journal Query size. Practical limits come from journalctl,
the temporary file system, available memory, DuckDB, and the operating system.
The release is read-only and does not support remote journals, journal
maintenance, interactive paging, or follow mode.

The journal relation has these stable columns:
  timestamp TIMESTAMPTZ
  message VARCHAR
  hostname VARCHAR
  systemd_unit VARCHAR
  user_unit VARCHAR
  identifier VARCHAR
  priority INTEGER
  pid BIGINT
  uid BIGINT
  gid BIGINT
  boot_id VARCHAR
  transport VARCHAR
  cursor VARCHAR
  entry JSON
The entry column preserves the complete Journal Entry, including fields that
are not in the stable column list.

Examples:
  journql -- -- 'SELECT count(*) FROM journal;'
  journql --format csv -- --unit sshd.service -- \
    'SELECT timestamp, message FROM journal;'
EOF
}

if [ "$#" -eq 1 ]; then
    case "$1" in
        --help)
            print_help
            exit 0
            ;;
        --version)
            print_version
            exit 0
            ;;
        *)
            ;;
    esac
fi

format_seen=0
format_value=table
help_seen=0
version_seen=0
first_separator_found=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --)
            first_separator_found=1
            shift
            break
            ;;
        --help)
            if [ "${help_seen}" -eq 1 ]; then
                usage_error 'option --help can be used only once.'
            fi
            help_seen=1
            shift
            ;;
        --version)
            if [ "${version_seen}" -eq 1 ]; then
                usage_error 'option --version can be used only once.'
            fi
            version_seen=1
            shift
            ;;
        --format)
            if [ "${format_seen}" -eq 1 ]; then
                usage_error 'option --format can be used only once.'
            fi
            if [ "$#" -lt 2 ] || [ "$2" = '--' ]; then
                usage_error 'option --format needs a value.'
            fi
            format_value=$2
            format_seen=1
            shift 2
            ;;
        --format=*)
            if [ "${format_seen}" -eq 1 ]; then
                usage_error 'option --format can be used only once.'
            fi
            format_value=${1#--format=}
            format_seen=1
            shift
            ;;
        --*)
            usage_error "unknown option: $1"
            ;;
        *)
            usage_error "expected a journql option or the first -- separator, got: $1"
            ;;
    esac
done

if [ "${help_seen}" -eq 1 ] && [ "${version_seen}" -eq 1 ]; then
    usage_error '--help and --version cannot be used together.'
fi

if [ "${help_seen}" -eq 1 ]; then
    usage_error 'option --help must be used alone.'
fi

if [ "${version_seen}" -eq 1 ]; then
    usage_error 'option --version must be used alone.'
fi

if [ "${format_seen}" -eq 1 ]; then
    case "${format_value}" in
        table|csv|json)
            ;;
        *)
            usage_error "invalid format: ${format_value}"
            ;;
    esac
fi

if [ "${first_separator_found}" -eq 0 ]; then
    usage_error 'a Journal Query needs two -- separators.'
fi

temporary_directory=${TMPDIR:-/tmp}
umask 077
snapshot=$(mktemp "$temporary_directory/journql.XXXXXXXXXX") || {
    printf 'journql: cannot create a private Journal Selection snapshot.\n' >&2
    exit 1
}

# shellcheck disable=SC2329  # Called indirectly by the EXIT trap.
cleanup_snapshot() {
    rm -f -- "$snapshot"
}

trap cleanup_snapshot 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15

selection_sentinel=$snapshot

if ! command -v journalctl >/dev/null 2>&1; then
    printf 'journql: journalctl was not found.\n' >&2
    exit 127
fi
journalctl_command=journalctl

selection_error() {
    usage_error "unsupported Journal Selection argument: $1"
}

selection_value_error() {
    usage_error "Journal Selection option $1 needs a value."
}

selection_value_is_present() {
    if [ "$#" -lt 2 ] || [ "$2" = '--' ] || [ "$2" = "$selection_sentinel" ]; then
        selection_value_error "$1"
    fi
}

field_match_is_valid() {
    field_name=${1%%=*}
    case "$field_name" in
        ''|*[!A-Z0-9_]*)
            return 1
            ;;
        [A-Z_]* )
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

run_journalctl_selection() {
    if [ "$1" = "$selection_sentinel" ]; then
        shift
        "$journalctl_command" "$@" --output=json --all --no-pager >"$snapshot"
        return $?
    fi

    if [ "$#" -gt 0 ]; then
        selection_argument=$1
        shift
        run_journalctl_selection "$@" "$selection_argument"
        return $?
    fi

    usage_error 'a Journal Query needs a second -- separator.'
}

collect_selection() {
    if [ "$#" -eq 0 ]; then
        usage_error 'a Journal Query needs a second -- separator.'
    fi

    if [ "$1" = '--' ]; then
        shift
        if [ "$#" -lt 2 ]; then
            usage_error 'the command needs exactly one Journal Query argument after the second -- separator.'
        fi
        journal_query=$1
        shift
        if [ "$1" != "$selection_sentinel" ]; then
            usage_error 'the command needs exactly one Journal Query argument after the second -- separator.'
        fi
        shift
        run_journalctl_selection "$@" "$selection_sentinel"
        return $?
    fi

    if [ "$1" = "$selection_sentinel" ]; then
        usage_error 'a Journal Query needs a second -- separator.'
    fi

    case "$1" in
        --system|--user|--merge|-m|--reverse|-r|--dmesg|-k|--case-sensitive)
            selection_argument=$1
            shift
            collect_selection "$@" "$selection_argument"
            ;;
        --ignore-case|-i)
            selection_argument=--case-sensitive=no
            shift
            collect_selection "$@" "$selection_argument"
            ;;
        --since|--until|--cursor|--after-cursor|--unit|--user-unit|--identifier|--priority|--facility|--grep|-S|-U|-c|-u|-t|-p|-g)
            selection_argument=$1
            selection_value_is_present "$@"
            selection_value=$2
            shift 2
            collect_selection "$@" "$selection_argument" "$selection_value"
            ;;
        --since=*|--until=*|--cursor=*|--after-cursor=*|--unit=*|--user-unit=*|--identifier=*|--priority=*|--facility=*|--grep=*)
            case "$1" in
                *=)
                    selection_value_error "${1%%=*}"
                    ;;
                *)
                    :
                    ;;
            esac
            selection_argument=$1
            shift
            collect_selection "$@" "$selection_argument"
            ;;
        --boot=*|--boot|-b)
            case "$1" in
                --boot=)
                    selection_value_error '--boot'
                    ;;
                --boot=*)
                    selection_argument=$1
                    shift
                    collect_selection "$@" "$selection_argument"
                    return $?
                    ;;
                *)
                    :
                    ;;
            esac
            selection_argument=$1
            shift
            if [ "$#" -gt 0 ] && [ "$1" != '--' ] && [ "$1" != "$selection_sentinel" ]; then
                case "$1" in
                    --*|+|*=*)
                        ;;
                    *)
                        selection_value=$1
                        shift
                        collect_selection "$@" "$selection_argument" "$selection_value"
                        return $?
                        ;;
                esac
            fi
            collect_selection "$@" "$selection_argument"
            ;;
        --lines=*|--lines|-n)
            case "$1" in
                --lines=)
                    selection_value_error '--lines'
                    ;;
                --lines=*)
                    selection_argument=$1
                    shift
                    collect_selection "$@" "$selection_argument"
                    return $?
                    ;;
                *)
                    :
                    ;;
            esac
            selection_argument=$1
            shift
            if [ "$#" -gt 0 ] && [ "$1" != '--' ] && [ "$1" != "$selection_sentinel" ]; then
                case "$1" in
                    all|+*[0-9]|[0-9]*)
                        selection_value=$1
                        shift
                        collect_selection "$@" "$selection_argument" "$selection_value"
                        return $?
                        ;;
                    *)
                        :
                        ;;
                esac
            fi
            collect_selection "$@" "$selection_argument"
            ;;
        --case-sensitive=*)
            case "$1" in
                --case-sensitive=)
                    selection_value_error '--case-sensitive'
                    ;;
                *)
                    :
                    ;;
            esac
            selection_argument=$1
            shift
            collect_selection "$@" "$selection_argument"
            ;;
        -S?*|-U?*|-c?*|-u?*|-t?*|-p?*|-g?*|-b?*|-n?*)
            selection_argument=$1
            shift
            collect_selection "$@" "$selection_argument"
            ;;
        *=*)
            field_match_is_valid "$1" || selection_error "$1"
            selection_argument=$1
            shift
            collect_selection "$@" "$selection_argument"
            ;;
        +)
            selection_argument=$1
            shift
            collect_selection "$@" "$selection_argument"
            ;;
        *)
            if [ "$2" = "$selection_sentinel" ]; then
                usage_error 'a Journal Query needs a second -- separator.'
            fi
            selection_error "$1"
            ;;
    esac
}

collect_selection "$@" "$selection_sentinel"
journalctl_status=$?
if [ "$journalctl_status" -ne 0 ]; then
    exit "$journalctl_status"
fi

# The installed package keeps the required DuckDB version beside the command
# under /usr/lib.
command_directory=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
bundled_duckdb="$command_directory/../lib/journql/duckdb"
if [ -x "$bundled_duckdb" ]; then
    duckdb_command=$bundled_duckdb
else
    printf 'journql: bundled DuckDB 1.4.5 was not found.\n' >&2
    exit 127
fi

# journalctl JSON field names are read from each complete object. The raw
# object remains in entry so fields outside the stable relation stay intact.
snapshot_sql_path=$(printf '%s' "$snapshot" | sed "s/'/''/g")
bootstrap_sql=$(cat <<EOF
SET TimeZone='UTC';
CREATE TABLE journal (
  timestamp TIMESTAMPTZ,
  message VARCHAR,
  hostname VARCHAR,
  systemd_unit VARCHAR,
  user_unit VARCHAR,
  identifier VARCHAR,
  priority INTEGER,
  pid BIGINT,
  uid BIGINT,
  gid BIGINT,
  boot_id VARCHAR,
  transport VARCHAR,
  cursor VARCHAR,
  entry JSON
);
INSERT INTO journal
SELECT
  CASE
    WHEN json_type(json, '\$.__REALTIME_TIMESTAMP') = 'VARCHAR' THEN
      try(to_timestamp(
        try_cast(json_extract_string(json, '\$.__REALTIME_TIMESTAMP') AS BIGINT) / 1000000.0
      ))
    ELSE NULL
  END AS timestamp,
  CASE WHEN json_type(json, '\$.MESSAGE') = 'VARCHAR'
    THEN json_extract_string(json, '\$.MESSAGE') ELSE NULL END AS message,
  CASE WHEN json_type(json, '\$._HOSTNAME') = 'VARCHAR'
    THEN json_extract_string(json, '\$._HOSTNAME') ELSE NULL END AS hostname,
  CASE WHEN json_type(json, '\$._SYSTEMD_UNIT') = 'VARCHAR'
    THEN json_extract_string(json, '\$._SYSTEMD_UNIT') ELSE NULL END AS systemd_unit,
  CASE WHEN json_type(json, '\$._SYSTEMD_USER_UNIT') = 'VARCHAR'
    THEN json_extract_string(json, '\$._SYSTEMD_USER_UNIT') ELSE NULL END AS user_unit,
  CASE WHEN json_type(json, '\$.SYSLOG_IDENTIFIER') = 'VARCHAR'
    THEN json_extract_string(json, '\$.SYSLOG_IDENTIFIER') ELSE NULL END AS identifier,
  CASE WHEN json_type(json, '\$.PRIORITY') = 'VARCHAR'
    THEN try_cast(json_extract_string(json, '\$.PRIORITY') AS INTEGER) ELSE NULL END AS priority,
  CASE WHEN json_type(json, '\$._PID') = 'VARCHAR'
    THEN try_cast(json_extract_string(json, '\$._PID') AS BIGINT) ELSE NULL END AS pid,
  CASE WHEN json_type(json, '\$._UID') = 'VARCHAR'
    THEN try_cast(json_extract_string(json, '\$._UID') AS BIGINT) ELSE NULL END AS uid,
  CASE WHEN json_type(json, '\$._GID') = 'VARCHAR'
    THEN try_cast(json_extract_string(json, '\$._GID') AS BIGINT) ELSE NULL END AS gid,
  CASE WHEN json_type(json, '\$._BOOT_ID') = 'VARCHAR'
    THEN json_extract_string(json, '\$._BOOT_ID') ELSE NULL END AS boot_id,
  CASE WHEN json_type(json, '\$._TRANSPORT') = 'VARCHAR'
    THEN json_extract_string(json, '\$._TRANSPORT') ELSE NULL END AS transport,
  CASE WHEN json_type(json, '\$.__CURSOR') = 'VARCHAR'
    THEN json_extract_string(json, '\$.__CURSOR') ELSE NULL END AS cursor,
  json AS entry
FROM read_json_objects('$snapshot_sql_path');
EOF
)

printf '%s\n' "$journal_query" | "$duckdb_command" "-${format_value}" :memory: -cmd "$bootstrap_sql"
duckdb_status=$?
exit "$duckdb_status"
