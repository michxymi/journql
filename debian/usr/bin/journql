#!/bin/sh
# Copyright 2026 Michael Xymitoulias
# SPDX-License-Identifier: Apache-2.0

JOURNQL_VERSION=0.1.0
DUCKDB_VERSION=1.4.5

usage_error() {
    printf 'journql: %s\n' "$1" >&2
    printf '%s\n' "journql: use 'journql --help' for help." >&2
    exit 2
}

print_version() {
    printf 'journql %s\n' "${JOURNQL_VERSION}"
    printf 'DuckDB %s\n' "${DUCKDB_VERSION}"
}

print_help() {
    cat <<'EOF'
Usage: journql [OPTIONS] -- [JOURNAL SELECTION] -- 'JOURNAL QUERY'

The command needs two -- separators. The first separator ends journql options.
The second separator ends the Journal Selection. The Journal Query is exactly
one shell argument after the second separator.

Options:
  --help                  Show this help and exit. Use this option alone.
  --version               Show journql and DuckDB versions and exit. Use this
                          option alone.
  --format FORMAT         Select the Query Result format.
                          FORMAT is table (default), csv, or json. The
                          --format=FORMAT form is also supported. Use this
                          option at most once.

Journal Selection controls:
  --system, --user, --merge
                          Select system, user, or merged Journal Entries.
  --since, --until, --cursor, --after-cursor, --boot
                          Select a time, cursor position, or boot position.
  --unit, --user-unit, --identifier, --priority, --facility
                          Select by unit, user unit, identifier, priority, or
                          facility.
  --grep, --ignore-case, --dmesg
                          Select by text pattern, case handling, or kernel
                          source.
  --lines and --reverse  Limit the Journal Selection and reverse its order.
  FIELD=VALUE and +      Use native field matches and the journal disjunction
                          operator. Path matches are not supported.

Documented short forms and separate-value forms for these journalctl
selection controls are allowed. journql keeps control of the output format,
complete field values, and pager behavior.
Short forms include -m, -b, -u, -t, -p, -g, -i, -k, -n, and -r. A value can
use a separate argument or the documented --option=value form.

The default Journal Selection is the normal journalctl selection. journql does
not add a time or size limit. It runs with the current user's authority. Add
the user to the systemd-journal group when the installed package requires it.

journql stores the Journal Selection in a private temporary file under the
configured temporary directory, or the standard temporary directory when it
is not configured. It writes newline-delimited JSON and removes the file after
use. A large Journal Selection can use temporary disk space equal to its JSON
size.
Select fewer Journal Entries when necessary.

The journal relation has these stable columns:
  timestamp TIMESTAMPTZ
  message VARCHAR
  hostname VARCHAR
  systemd_unit VARCHAR
  user_unit VARCHAR
  identifier VARCHAR
  priority INTEGER
  pid BIGINT
  uid BIGINT
  gid BIGINT
  boot_id VARCHAR
  transport VARCHAR
  cursor VARCHAR
  entry JSON
The entry column preserves the complete Journal Entry, including fields that
are not in the stable column list.

Examples:
  journql -- -- 'SELECT count(*) FROM journal;'
  journql --format csv -- --unit sshd.service -- \
    'SELECT timestamp, message FROM journal;'
EOF
}

if [ "$#" -eq 1 ]; then
    case "$1" in
        --help)
            print_help
            exit 0
            ;;
        --version)
            print_version
            exit 0
            ;;
        *)
            ;;
    esac
fi

format_seen=0
format_value=table
help_seen=0
version_seen=0
first_separator_found=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --)
            first_separator_found=1
            shift
            break
            ;;
        --help)
            if [ "${help_seen}" -eq 1 ]; then
                usage_error 'option --help can be used only once.'
            fi
            help_seen=1
            shift
            ;;
        --version)
            if [ "${version_seen}" -eq 1 ]; then
                usage_error 'option --version can be used only once.'
            fi
            version_seen=1
            shift
            ;;
        --format)
            if [ "${format_seen}" -eq 1 ]; then
                usage_error 'option --format can be used only once.'
            fi
            if [ "$#" -lt 2 ] || [ "$2" = '--' ]; then
                usage_error 'option --format needs a value.'
            fi
            format_value=$2
            format_seen=1
            shift 2
            ;;
        --format=*)
            if [ "${format_seen}" -eq 1 ]; then
                usage_error 'option --format can be used only once.'
            fi
            format_value=${1#--format=}
            format_seen=1
            shift
            ;;
        --*)
            usage_error "unknown option: $1"
            ;;
        *)
            usage_error "expected a journql option or the first -- separator, got: $1"
            ;;
    esac
done

if [ "${help_seen}" -eq 1 ] && [ "${version_seen}" -eq 1 ]; then
    usage_error '--help and --version cannot be used together.'
fi

if [ "${help_seen}" -eq 1 ]; then
    usage_error 'option --help must be used alone.'
fi

if [ "${version_seen}" -eq 1 ]; then
    usage_error 'option --version must be used alone.'
fi

if [ "${format_seen}" -eq 1 ]; then
    case "${format_value}" in
        table|csv|json)
            ;;
        *)
            usage_error "invalid format: ${format_value}"
            ;;
    esac
fi

if [ "${first_separator_found}" -eq 0 ]; then
    usage_error 'a Journal Query needs two -- separators.'
fi

temporary_directory=${TMPDIR:-/tmp}
snapshot=$(mktemp "$temporary_directory/journql.XXXXXXXXXX") || {
    printf 'journql: cannot create a private Journal Selection snapshot.\n' >&2
    exit 1
}

cleanup_snapshot() {
    rm -f -- "$snapshot"
}

trap cleanup_snapshot 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15

selection_sentinel=$snapshot

if ! command -v journalctl >/dev/null 2>&1; then
    printf 'journql: journalctl was not found.\n' >&2
    exit 127
fi
journalctl_command=journalctl

collect_selection() {
    if [ "$#" -eq 0 ]; then
        usage_error 'a Journal Query needs a second -- separator.'
    fi

    if [ "$1" = '--' ]; then
        shift
        if [ "$#" -lt 2 ]; then
            usage_error 'the command needs exactly one Journal Query argument after the second -- separator.'
        fi
        journal_query=$1
        shift
        if [ "$1" != "$selection_sentinel" ]; then
            usage_error 'the command needs exactly one Journal Query argument after the second -- separator.'
        fi
        shift
        "$journalctl_command" "$@" --output=json --all --no-pager >"$snapshot"
        return $?
    fi

    if [ "$1" = "$selection_sentinel" ]; then
        usage_error 'a Journal Query needs a second -- separator.'
    fi

    selection_argument=$1
    shift
    collect_selection "$@" "$selection_argument"
}

collect_selection "$@" "$selection_sentinel"
journalctl_status=$?
if [ "$journalctl_status" -ne 0 ]; then
    exit "$journalctl_status"
fi

# The installed package keeps the required DuckDB version beside the command
# under /usr/lib.
command_directory=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
bundled_duckdb="$command_directory/../lib/journql/duckdb"
if [ -x "$bundled_duckdb" ]; then
    duckdb_command=$bundled_duckdb
else
    printf 'journql: bundled DuckDB 1.4.5 was not found.\n' >&2
    exit 127
fi

# journalctl JSON field names are read from each complete object. The raw
# object remains in entry so fields outside the stable relation stay intact.
snapshot_sql_path=$(printf '%s' "$snapshot" | sed "s/'/''/g")
bootstrap_sql=$(cat <<EOF
SET TimeZone='UTC';
CREATE TABLE journal AS
SELECT
  try_cast(to_timestamp(try_cast(json_extract_string(json, '\$.__REALTIME_TIMESTAMP') AS BIGINT) / 1000000.0) AS TIMESTAMPTZ) AS timestamp,
  json_extract_string(json, '\$.MESSAGE') AS message,
  json_extract_string(json, '\$._HOSTNAME') AS hostname,
  json_extract_string(json, '\$._SYSTEMD_UNIT') AS systemd_unit,
  json_extract_string(json, '\$._SYSTEMD_USER_UNIT') AS user_unit,
  json_extract_string(json, '\$.SYSLOG_IDENTIFIER') AS identifier,
  try_cast(json_extract_string(json, '\$.PRIORITY') AS INTEGER) AS priority,
  try_cast(json_extract_string(json, '\$._PID') AS BIGINT) AS pid,
  try_cast(json_extract_string(json, '\$._UID') AS BIGINT) AS uid,
  try_cast(json_extract_string(json, '\$._GID') AS BIGINT) AS gid,
  json_extract_string(json, '\$._BOOT_ID') AS boot_id,
  json_extract_string(json, '\$._TRANSPORT') AS transport,
  json_extract_string(json, '\$.__CURSOR') AS cursor,
  json AS entry
FROM read_json_objects('$snapshot_sql_path');
EOF
)

printf '%s\n' "$journal_query" | "$duckdb_command" "-${format_value}" :memory: -cmd "$bootstrap_sql"
